function(require_match content expression description)
  string(REGEX MATCH "${expression}" match "${content}")
  if(NOT match)
    message(FATAL_ERROR "Missing ${description}")
  endif()
endfunction()

function(reject_match content expression description)
  string(REGEX MATCH "${expression}" match "${content}")
  if(match)
    message(FATAL_ERROR "Unexpected ${description}")
  endif()
endfunction()

