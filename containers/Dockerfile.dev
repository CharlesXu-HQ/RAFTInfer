# The plan-required tag remains unresolved here; Task 6 must record the target-pulled
# image digest. Apt packages and rustup remain mutable provenance risks until then.
FROM rapidsai/base:26.06-cuda13-py3.13

ARG RUSTUP_DIST_SERVER=https://static.rust-lang.org
ARG RUSTUP_UPDATE_ROOT=https://static.rust-lang.org/rustup

USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends cmake curl ca-certificates g++ ninja-build pkg-config \
 && dpkg --compare-versions "$(cmake --version | sed -n '1s/.* //p')" ge 3.26.4 \
 && printf 'int main(void) { return 0; }\n' | c++ -x c++ - -o /tmp/cxx-smoke \
 && /tmp/cxx-smoke \
 && rm -f /tmp/cxx-smoke \
 && rm -rf /var/lib/apt/lists/*

# Verify that this base image defines the rapids user during target image validation.
USER rapids
ENV RUSTUP_HOME=/home/rapids/.rustup
ENV CARGO_HOME=/home/rapids/.cargo
ENV PATH=/home/rapids/.cargo/bin:${PATH}
RUN export RUSTUP_DIST_SERVER RUSTUP_UPDATE_ROOT \
 && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o /tmp/rustup-init \
 && sh /tmp/rustup-init -y --profile minimal --default-toolchain 1.96.0 \
 && test "$(rustc --version | awk '{print $2}')" = 1.96.0 \
 && rm -f /tmp/rustup-init

WORKDIR /workspace
ENTRYPOINT []
CMD ["bash"]
